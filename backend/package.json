{
  "name": "vendra-backend",
  "version": "1.0.0",
  "description": "Vendra Multi-Vendor Digital Marketplace - Node.js Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/migrate.js",
