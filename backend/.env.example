# ══════════════════════════════════════
# Vendra Backend Environment Variables
# ══════════════════════════════════════
# Copy this file to .env and fill in your values

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:vendra_dev@localhost:5433/vendra_db   # matches docker-compose.yml

# JWT Secret (use a strong random string)
JWT_SECRET=vendra_super_secret_key_change_in_production

# Server Port
PORT=3000

# development | production
#   development: manual rider GPS, test-card helpers, fast timers (dispute window ≤ 2 min,
#                auto-cancel ≤ 5/10 min), demo-account quick login, localhost CORS, seeding allowed
#   production:  all of those off; refuses to start without a strong JWT_SECRET and ALLOWED_ORIGINS
APP_MODE=development

# Deployed frontend origins allowed by CORS (comma-separated, no trailing slash).
# Localhost origins are also allowed in development mode.
ALLOWED_ORIGINS=https://admin.example.com,https://shop.example.com

# Card payment gateway — Vendra Pay sandbox from docker-compose.yml (dashboard at http://localhost:4242)
GATEWAY_URL=http://localhost:4242
# Where the apps reach the gateway, if different (a phone on Wi-Fi needs your PC's LAN address)
# GATEWAY_PUBLIC_URL=http://192.168.1.10:4242
GATEWAY_PUBLISHABLE_KEY=pk_test_vendra
GATEWAY_SECRET_KEY=sk_test_vendra
GATEWAY_WEBHOOK_SECRET=whsec_vendra

# File storage (product photos + dispute evidence) — any S3-compatible bucket.
# Local: SeaweedFS from docker-compose.yml (keys in docker/seaweedfs-s3.json).
# Production (Cloudflare R2): S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com,
#   S3_REGION=auto, S3_FORCE_PATH_STYLE=false, and an R2 API token's key pair.
# Remove S3_BUCKET to keep files on disk in UPLOAD_DIR instead (default ./uploads).
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=vendra-files
S3_ACCESS_KEY_ID=vendra
S3_SECRET_ACCESS_KEY=vendra_dev_secret
