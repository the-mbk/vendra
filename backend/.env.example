# ══════════════════════════════════════
# Vendra Backend Environment Variables
# ══════════════════════════════════════
# Copy this file to .env and fill in your values

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:vendra_dev@localhost:5433/vendra_db   # matches docker-compose.yml

# JWT Secret (use a strong random string)
JWT_SECRET=vendra_super_secret_key_change_in_production

# Server Port
PORT=3000

# Deployed frontend origins allowed by CORS (comma-separated, no trailing slash).
# Localhost origins are always allowed unless NODE_ENV=production.
ALLOWED_ORIGINS=https://admin.example.com,https://shop.example.com
NODE_ENV=development

# Where dispute evidence photos are stored (use a persistent volume in production)
# UPLOAD_DIR=./uploads
