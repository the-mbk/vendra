# ══════════════════════════════════════
# Vendra Backend Environment Variables
# ══════════════════════════════════════
# Copy this file to .env and fill in your values

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:vendra_dev@localhost:5433/vendra_db   # matches docker-compose.yml

# JWT Secret (use a strong random string)
JWT_SECRET=vendra_super_secret_key_change_in_production

# Server Port
PORT=3000

# development | production
#   development: manual rider GPS, test-card helpers, fast timers (dispute window ≤ 2 min,
#                auto-cancel ≤ 5/10 min), demo-account quick login, localhost CORS, seeding allowed
#   production:  all of those off; refuses to start without a strong JWT_SECRET and ALLOWED_ORIGINS
APP_MODE=development

# Deployed frontend origins allowed by CORS (comma-separated, no trailing slash).
# Localhost origins are also allowed in development mode.
ALLOWED_ORIGINS=https://admin.example.com,https://shop.example.com

# Card payment gateway — Vendra Pay sandbox from docker-compose.yml (dashboard at http://localhost:4242)
GATEWAY_URL=http://localhost:4242
# Where the apps reach the gateway, if different (a phone on Wi-Fi needs your PC's LAN address)
# GATEWAY_PUBLIC_URL=http://192.168.1.10:4242
GATEWAY_PUBLISHABLE_KEY=pk_test_vendra
GATEWAY_SECRET_KEY=sk_test_vendra
GATEWAY_WEBHOOK_SECRET=whsec_vendra

# ── Stripe instead of Vendra Pay ──
# PAYMENT_PROVIDER=stripe            # vendrapay (default) | stripe
# STRIPE_SECRET_KEY=sk_test_...      # Dashboard → Developers → API keys (test mode)
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...    # printed by: stripe listen --forward-to localhost:3000/api/payments/webhook
# STRIPE_PKR_PER_UNIT=280            # rupees per unit of your Stripe account's currency (withdrawals are converted)
# STRIPE_CONNECT_COUNTRY=US          # country for payout (Connect Express) accounts; default: your Stripe account's
# PUBLIC_API_URL=http://localhost:3000  # where Stripe / Payoneer send the browser back after payout setup

# ── Withdrawals ──
# PAYOUT_PROVIDER=payoneer           # card (Vendra Pay only) | payoneer (default with Stripe) | stripe_connect
# Payoneer: the defaults talk to the local simulator (docker compose service "payoneer", http://localhost:4343).
# With Payoneer partner sandbox credentials, set:
# PAYONEER_API_URL=https://api.sandbox.payoneer.com
# PAYONEER_AUTH_URL=https://login.sandbox.payoneer.com/api/v2/oauth2/token
# PAYONEER_CLIENT_ID=...
# PAYONEER_CLIENT_SECRET=...
# PAYONEER_PROGRAM_ID=...
# PAYONEER_PAYEE_PORTAL=https://myaccount.payoneer.com
# PAYONEER_PKR_PER_USD=280           # withdrawals are paid in USD at this rate
# PAYONEER_IPCN_TOKEN=ipcn_vendra    # register {PUBLIC_API_URL}/api/payouts/payoneer/ipcn?token=<this> with Payoneer

# File storage (product photos + dispute evidence) — any S3-compatible bucket.
# Local: SeaweedFS from docker-compose.yml (keys in docker/seaweedfs-s3.json).
# Production (Cloudflare R2): S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com,
#   S3_REGION=auto, S3_FORCE_PATH_STYLE=false, and an R2 API token's key pair.
# Remove S3_BUCKET to keep files on disk in UPLOAD_DIR instead (default ./uploads).
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=vendra-files
S3_ACCESS_KEY_ID=vendra
S3_SECRET_ACCESS_KEY=vendra_dev_secret

# Rate limits (SSR 01). Defaults: 300 requests/min per IP (2000 in development), 10 failed sign-ins per email per 15 min, 20 sign-ups per IP per hour
# RATE_LIMIT_MAX=300
# LOGIN_RATE_LIMIT_MAX=10
# SIGNUP_RATE_LIMIT_MAX=20
# Behind a reverse proxy, the number of hops so limits see the client IP
# TRUST_PROXY=1
